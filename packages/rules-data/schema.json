{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jipgak.kr/schema/rule.json",
  "title": "집각 상품 규칙",
  "description": "packages/rules-engine/src/types.ts의 Rule과 같은 구조입니다. 금액은 원 단위 정수, 금리는 % 단위입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "effectiveFrom", "source", "conditions", "manualChecks"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["loan", "supply"] },
    "effectiveFrom": { "$ref": "#/$defs/isoDate" },
    "effectiveTo": { "$ref": "#/$defs/isoDate" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "checkedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "checkedAt": { "$ref": "#/$defs/isoDate" }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "conditions": { "$ref": "#/$defs/node" },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caps"],
      "properties": {
        "caps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "options"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["amount"],
                      "properties": {
                        "when": { "$ref": "#/$defs/node" },
                        "amount": { "$ref": "#/$defs/won" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["ratio", "of"],
                      "properties": {
                        "when": { "$ref": "#/$defs/node" },
                        "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                        "of": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "adjustments", "discounts", "discountCap", "floor"],
      "properties": {
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rowFact", "rowUpTo", "columns", "rates"],
          "properties": {
            "rowFact": { "type": "string" },
            "rowUpTo": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/won" } },
            "columns": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "years"],
                  "properties": {
                    "kind": { "const": "term" },
                    "years": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "integer", "minimum": 1 }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "fact", "upTo"],
                  "properties": {
                    "kind": { "const": "fact" },
                    "fact": { "type": "string" },
                    "upTo": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "oneOf": [{ "$ref": "#/$defs/won" }, { "type": "null" }] }
                    }
                  }
                }
              ]
            },
            "rates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/percent" }
              }
            }
          }
        },
        "topRowWhen": { "$ref": "#/$defs/node" },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "when", "deltaPp"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "when": { "$ref": "#/$defs/node" },
              "deltaPp": { "type": "number" }
            }
          }
        },
        "discounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "options"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["when", "pp"],
                  "properties": {
                    "when": { "$ref": "#/$defs/node" },
                    "pp": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "discountCap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "overrides"],
          "properties": {
            "default": { "type": "number", "minimum": 0 },
            "overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "value"],
                "properties": {
                  "when": { "$ref": "#/$defs/node" },
                  "value": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "floor": { "$ref": "#/$defs/percent" }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "text"],
        "properties": {
          "id": { "type": "string" },
          "when": { "$ref": "#/$defs/node" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manualChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "won": { "type": "integer", "minimum": 0 },
    "percent": { "type": "number", "minimum": 0, "maximum": 30 },
    "duration": { "type": "string", "pattern": "^P(?=\\d)(\\d+Y)?(\\d+M)?(\\d+D)?$" },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "fact", "op", "value"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "fact": { "type": "string" },
        "op": { "enum": ["<=", "<", ">=", ">", "==", "!="] },
        "value": { "type": ["number", "boolean", "string"] }
      }
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "fact", "op", "value"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "fact": { "type": "string" },
        "op": { "enum": ["withinPast", "withinNext"] },
        "value": { "$ref": "#/$defs/duration" }
      }
    },
    "all": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "any": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/compare" },
        { "$ref": "#/$defs/dateWindow" },
        { "$ref": "#/$defs/all" },
        { "$ref": "#/$defs/any" },
        { "$ref": "#/$defs/ref" }
      ]
    }
  }
}
